# ====================================================================
# WienWasGeht (Vienna Event API) — Environment Configuration Template
# ====================================================================

# Port for NestJS backend REST API
PORT=3000

# PostgreSQL / PostGIS Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vienna_events?schema=public"

# Optional External API Keys (Ingestion & Enrichment)
# Note: Providers with public feeds (Stadt Wien Open Data, Resident Advisor, Goodnight, events.at) work out-of-the-box without keys.
GEMINI_API_KEY=
NINJA_API_KEY=
EVENTBRITE_API_KEY=
EVENTFROG_API_KEY=
TICKETMASTER_API_KEY=
